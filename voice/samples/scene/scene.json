{"audio":"scene.wav","kermit_only_audio":"scene_kermit_only.wav","sample_rate":24000,"duration":68.37,"human_voice":"am_michael","kermit_voice":"am_fenrir","clips":[{"who":"human","turn":1,"audio":"human_01.wav","t":0.5,"duration":2.455,"text":"Hey Kermit wake up there's a lot of people here.","placeholder":false,"words":[{"w":"Hey","t0":0.51,"t1":0.773},{"w":"Kermit","t0":0.773,"t1":1.247},{"w":"wake","t0":1.247,"t1":1.497},{"w":"up","t0":1.497,"t1":1.685},{"w":"there's","t0":1.685,"t1":1.872},{"w":"a","t0":1.872,"t1":1.935},{"w":"lot","t0":1.935,"t1":2.098},{"w":"of","t0":2.098,"t1":2.185},{"w":"people","t0":2.185,"t1":2.56},{"w":"here.","t0":2.56,"t1":2.955}]},{"who":"kermit","turn":1,"beat":"wake","trigger":"turn","audio":"kermit_01.wav","timeline":"kermit_01.timeline.json","t":3.655,"duration":3.605,"text":"Whoa! That is a lot of people. Hi, everybody! I'm Happy Kermit.","emotion":"surprised","gaze":"audience","events":[{"t":3.674,"type":"surprise","intensity":1.0,"word":0},{"t":4.299,"type":"look_around","intensity":0.7,"word":1},{"t":5.444,"type":"head_bob","intensity":0.8,"word":7}]},{"who":"human","turn":2,"audio":"human_02.wav","t":7.86,"duration":2.775,"text":"So Kermit how are you feeling about AI these days?","placeholder":false,"words":[{"w":"So","t0":7.88,"t1":8.055},{"w":"Kermit","t0":8.055,"t1":8.38},{"w":"how","t0":8.38,"t1":8.555},{"w":"are","t0":8.555,"t1":8.655},{"w":"you","t0":8.655,"t1":8.818},{"w":"feeling","t0":8.818,"t1":9.143},{"w":"about","t0":9.143,"t1":9.443},{"w":"AI","t0":9.443,"t1":9.855},{"w":"these","t0":9.855,"t1":10.08},{"w":"days?","t0":10.08,"t1":10.635}]},{"who":"kermit","turn":2,"beat":"feeling","trigger":"turn","audio":"kermit_02.wav","timeline":"kermit_02.timeline.json","t":11.335,"duration":8.465,"text":"Honestly? A little tired. Every week there's a new model, a new agent, a new robot. Some days it feels like a sci-fi movie, and not the fun kind.","emotion":"thinking","gaze":"speaker","events":[{"t":11.345,"type":"sigh","intensity":0.6,"word":0},{"t":13.235,"type":"look_at","intensity":0.5,"target":"audience","word":4},{"t":16.401,"type":"nod","intensity":0.6,"word":16}]},{"who":"human","turn":3,"audio":"human_03.wav","t":20.4,"duration":1.22,"text":"Is that why you're here?","placeholder":false,"words":[{"w":"Is","t0":20.4,"t1":20.518},{"w":"that","t0":20.518,"t1":20.743},{"w":"why","t0":20.743,"t1":20.98},{"w":"you're","t0":20.98,"t1":21.18},{"w":"here?","t0":21.18,"t1":21.62}]},{"who":"kermit","turn":3,"beat":"why_here","trigger":"turn","audio":"kermit_03.wav","timeline":"kermit_03.timeline.json","t":22.32,"duration":5.35,"text":"Yep! I'm the friendly face of Happy, an app for talking to your AI agents. Less dystopia, more frog.","emotion":"happy","gaze":"speaker","events":[{"t":22.349,"type":"nod","intensity":0.8,"word":0},{"t":26.413,"type":"lean_in","intensity":0.6,"word":15}]},{"who":"human","turn":4,"audio":"human_04.wav","t":28.27,"duration":1.925,"text":"And wait are you running in the cloud?","placeholder":false,"words":[{"w":"And","t0":28.29,"t1":28.452},{"w":"wait","t0":28.452,"t1":28.765},{"w":"are","t0":28.765,"t1":28.903},{"w":"you","t0":28.903,"t1":29.115},{"w":"running","t0":29.115,"t1":29.453},{"w":"in","t0":29.453,"t1":29.527},{"w":"the","t0":29.527,"t1":29.615},{"w":"cloud?","t0":29.615,"t1":30.195}]},{"who":"kermit","turn":4,"beat":"cloud","trigger":"turn","audio":"kermit_04.wav","timeline":"kermit_04.timeline.json","t":30.895,"duration":4.625,"text":"Nope! My whole brain is Gemma, running right here on this laptop. No cloud, no internet, just me!","emotion":"excited","gaze":"audience","events":[{"t":30.928,"type":"shake","intensity":0.8,"word":0},{"t":31.504,"type":"look_at","intensity":0.7,"target":"laptop","word":1},{"t":34.184,"type":"flail","intensity":0.8,"word":12}]},{"who":"human","turn":5,"audio":"human_05.wav","t":36.12,"duration":5.725,"text":"So the whole point is that everything runs right here on the device, and the reason that matters is","placeh